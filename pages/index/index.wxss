/* pages/index/index.wxss */

/* 容器 */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 颜色显示盒子 */
.color-box {
  width: 400rpx;
  height: 400rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  transition: all 0.5s ease;
  margin-bottom: 80rpx;
}

/* 颜色名称文字 */
.color-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
}

/* 切换按钮 */
.switch-btn {
  width: 400rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.4);
  margin-bottom: 40rpx;
}

/* 按钮点击效果 */
.button-hover {
  opacity: 0.8;
  transform: scale(0.95);
}

/* 提示文字 */
.hint-text {
  font-size: 28rpx;
  color: #fff;
  opacity: 0.9;
}
