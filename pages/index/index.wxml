<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 颜色显示区域 -->
  <view class="color-box" style="background-color: {{currentColor}};">
    <text class="color-text">{{colorName}}</text>
  </view>
  
  <!-- 点击切换按钮 -->
  <button class="switch-btn" bindtap="switchColor" hover-class="button-hover">
    点击切换颜色
  </button>
  
  <!-- 颜色数量提示 -->
  <text class="hint-text">共有 {{colors.length}} 种颜色可选</text>
</view>
